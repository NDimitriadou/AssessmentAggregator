{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ExternalApis": {
    "Weather": {
      "BaseUrl": "https://api.open-meteo.com/",
      "GeocodingUrl": "https://geocoding-api.open-meteo.com/",
      "MaxItems": 7
    },
    "News": {
      "BaseUrl": "https://hn.algolia.com/",
      "MaxItems": 20
    },
    "Books": {
      "BaseUrl": "https://openlibrary.org/",
      "MaxItems": 20
    }
  },

  "Resilience": {
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMs": 200,
    "AttemptTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 15
  },

  "Caching": {
    "FreshSeconds": 120,
    "FallbackMinutes": 60
  },

  "Statistics": {
    "FastThresholdMs": 100,
    "SlowThresholdMs": 200,
    "SampleRetentionMinutes": 15
  },

  "AnomalyDetection": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "WindowMinutes": 5,
    "ThresholdPercent": 50,
    "MinRecentSamples": 3
  },

  "Jwt": {
    "Issuer": "ReadInEveryWeatherAggregator",
    "Audience": "ReadInEveryWeatherAggregator.Clients",
    "SigningKey": "",
    "ExpiryMinutes": 60,
    "DemoUsername": "demo",
    "DemoPassword": ""
  }
}
